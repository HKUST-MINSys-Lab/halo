# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
uv.lock
venv/
env/

# Heavy artifacts anywhere — never commit (regenerated from source)
*.npy
*.npz
*.parquet
*.pt
*.mdl
*.ckpt
*.pth
*.tar.gz

# data/: CODE and authored metadata ARE tracked; downloads & converter-generated files are NOT.
# Authored (tracked): convert.py, metadata.json, eval_labels.json.
# Generated (ignored): sessions/, grids/, manifest.json, labels.json (session->activity map),
# events.json (device-session -> shared physical-event map).
#
# recordings.json (session -> continuous capture) is a converter output too, but is deliberately
# NOT ignored alongside its siblings. It defines the enrollment LEAKAGE UNIT: without it a stream's
# execution ids silently fall back to one-per-label-block, which on opportunity overcounts
# independent enrollment examples by 10.2x and turns a k-curve into adjacent-window binding. A
# checkout that has grids restored from elsewhere but no local conversion would inherit that
# silently. `data.scripts.curate.build_recording_maps --check` verifies it against the converters.
data/datasets/*/downloads/
data/datasets/*/download/
data/datasets/*/raw/
data/datasets/*/sessions/
data/datasets/*/processed/
data/datasets/*/grids/
data/datasets/*/manifest.json
data/datasets/*/labels.json
data/datasets/*/events.json
data/datasets/*/debug_*.png

# Label-free pretraining tree (data/pretraining/). Same generated artefacts as the labelled
# tree above: everything here is rebuilt by a fetcher or converter and must never be committed.
# This corpus is designed to reach ~110 GB, so an unignored grids/ directory is not a nuisance,
# it is a repository-destroying commit.
data/pretraining/*/downloads/
data/pretraining/*/download/
data/pretraining/*/raw/
data/pretraining/*/sessions/
data/pretraining/*/processed/
data/pretraining/*/grids/
data/pretraining/*/manifest.json
data/pretraining/*/labels.json
data/pretraining/*/events.json
data/pretraining/*/debug_*.png
# Nymeria converts into sibling dataset directories, so its generated output can also land one
# level deeper than the module that produced it.
data/pretraining/*/*/downloads/
data/pretraining/*/*/sessions/
data/pretraining/*/*/grids/
data/pretraining/*/*/manifest.json
data/pretraining/*/*/labels.json
data/**/bundles/

# Application-study datasets are deliberately isolated from the representation-training corpus.
# Keep acquisition code and source contracts, but never version downloaded or derived payloads.
applications/motion_monitoring/data/sources/*/downloads/
applications/motion_monitoring/data/sources/*/raw/
applications/motion_monitoring/data/sources/*/processed/
applications/motion_monitoring/data/sources/*/manifests/
applications/motion_monitoring/artifacts/
training_output/
test_output/
eval/results/

# baselines/: adapters + citations ARE tracked; cloned upstream repos are NOT.
baselines/*/repo/
auxiliary_repos/

# Secrets — never commit
.env
*.env
cloud/.env
*.key
*.pem
credentials*.json

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
training/tokenizer/outputs/**/*.pt
training/tokenizer/outputs/*

# Per-run training/eval artifacts (logs, eval jsons); .pt already ignored above.
# Keep one-time analysis deliverables (m0_probe/, m2_gate/, corpus_audit/, objective_health/).
training/tokenizer/outputs/pretrain*/
training/tokenizer/outputs/*/
training/tokenizer/outputs/**/*.log
training/evidence/outputs/telemetry/

# Per-run Phase-B artifacts. Mirrors the tokenizer rule above: memory banks, fitted gates and
# per-run eval dumps are reproducible from the source plus a checkpoint, and are far too heavy to
# version (the checkpoint-selection study alone is 15 GB, and memory_bank.pt is 2.6 GB). Top-level
# analysis deliverables stay tracked; per-run subdirectories do not.
training/evidence/outputs/**/*.pt
training/evidence/outputs/*/
training/evidence/outputs/**/*.log
training/evidence/outputs/*.json
training/evidence/outputs/*.log
training/compare/outputs/
runs/
cache/
results/local/
training/support_classifier/evaluations/*.log

# Historical per-run evaluation and locally trained baseline artifacts. Promoted summaries live in
# docs/results; these raw outputs remain recoverable from the pre-application archive branch.
eval/adaptation_results/
eval/adaptation_tables/
eval/adaptation_feature_cache/
baselines/*/pretrain_run/
baselines/*/*.meta.json

# Debug plots regenerated on demand from the gridded corpus.
data/scripts/debug/outputs/

# agent worktrees / session scratch
.claude/

# Dataset/baseline reference PDFs: kept locally for code-vs-paper verification, never redistributed
# (copyright). The provenance that MATTERS is versioned: SOURCE.txt / citation.json / VERIFIED.md.
references/**/*.pdf
references/**/webpage.html
# Extracted full text of the same PDFs — same copyright status, same rule. The notes derived from
# them (docs/design/LITERATURE_*.md) ARE versioned; the source text is not.
references/**/paper.txt

# Per-run support-classifier artifacts (logs, checkpoints, feature caches, per-run eval trees).
# Mirrors the tokenizer rules above. The single promoted result artifact is force-added when a
# run is promoted in docs/results/RESULTS.md; everything else stays local.
training/support_classifier/outputs/*/
training/support_classifier/outputs/*
training/support_classifier/evaluations/*/
training/support_classifier/evaluations/*

# Converter backups taken before a schema change (e.g. the 2026-09-13 grid-clock rebuild).
data/datasets/*/grids_legacy_*/
